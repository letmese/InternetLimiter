<Window x:Class="Valve.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options" Height="500" Width="680" MinHeight="420" MinWidth="540"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main 2-column view matching NetLimiter Options window -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="150" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Tree -->
            <Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Padding="6">
                <TreeView Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}">
                    <TreeViewItem Header="Client" IsExpanded="True" Foreground="{DynamicResource Text}" FontWeight="SemiBold" FontSize="12.5">
                        <TreeViewItem Header="Activity View" IsSelected="True" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0" />
                    </TreeViewItem>
                </TreeView>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Right Content Panel -->
            <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Padding="18,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
                    <StackPanel>
                        <!-- Group Header -->
                        <TextBlock Text="Activity View" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,0,12" />

                        <!-- Auto-Refresh Checkbox -->
                        <CheckBox x:Name="ChkAutoRefresh" Content="Auto-Refresh" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,0,0,16" IsChecked="True" />

                        <Separator Background="{DynamicResource Line}" Margin="0,0,0,14" />

                        <!-- Columns to show Header -->
                        <TextBlock Text="Columns to show" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,0,0,10" />

                        <!-- Columns List -->
                        <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Padding="14,10">
                            <StackPanel>
                                <CheckBox x:Name="ChkColName" Content="Name" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,4" />
                                <CheckBox x:Name="ChkColDlRate" Content="RateIn (DL Rate)" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,4" />
                                <CheckBox x:Name="ChkColUlRate" Content="RateOut (UL Rate)" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,4" />
                                <CheckBox x:Name="ChkColDlLimit" Content="LimitIn (DL Limit)" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,4" />
                                <CheckBox x:Name="ChkColUlLimit" Content="LimitOut (UL Limit)" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,4" />
                                <CheckBox x:Name="ChkColDlTotal" Content="TotalIn (DL Total)" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,4" />
                                <CheckBox x:Name="ChkColUlTotal" Content="TotalOut (UL Total)" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,4" />
                                <CheckBox x:Name="ChkColInFw" Content="FwIn (In Fw)" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,4" />
                                <CheckBox x:Name="ChkColOutFw" Content="FwOut (Out Fw)" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,4" />
                                <CheckBox x:Name="ChkColStatus" Content="Status" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,4" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom Action Buttons: Save, Apply, Cancel -->
        <DockPanel Grid.Row="1" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Save" Style="{StaticResource Btn}" Background="{DynamicResource Down}" Foreground="#051525" FontWeight="SemiBold" Width="85" Height="28" Margin="0,0,8,0" IsDefault="True" Click="Save_Click" />
                <Button Content="Apply" Style="{StaticResource Btn}" Width="85" Height="28" Margin="0,0,8,0" Click="Apply_Click" />
                <Button Content="Cancel" Style="{StaticResource Btn}" Width="85" Height="28" IsCancel="True" Click="Cancel_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
