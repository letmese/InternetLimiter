                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                        </TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="ColDlRate" Width="95" SortMemberPath="DL Rate">
