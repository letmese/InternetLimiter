<Window x:Class="Valve.FilterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filter Editor" Height="560" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filter Name -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Filter Name" Foreground="{StaticResource Text}" FontSize="12.5" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="NameBox" Style="{StaticResource DarkTextBox}" Padding="8,5" />
        </Grid>

        <!-- Filter Type -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Filter Type" Foreground="{StaticResource Text}" FontSize="12.5" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" x:Name="TypeBox" Width="180" HorizontalAlignment="Left" SelectionChanged="TypeBox_SelectionChanged">
                <ComboBoxItem Content="Filter (normal conditions)" Tag="Normal" IsSelected="True" />
                <ComboBoxItem Content="Zone" Tag="Zone" />
                <ComboBoxItem Content="Composite (OR of child filters)" Tag="Composite" />
            </ComboBox>
        </Grid>

        <!-- Composite children picker -->
        <Border Grid.Row="2" x:Name="CompositePanel" Visibility="Collapsed"
                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4"
                Background="{StaticResource PanelAlt}" Padding="8" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Child filters (match if ANY child matches — OR logic)" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,0,0,6" />
                <ListBox x:Name="ChildFilterList" Height="110"
                         Background="{StaticResource PanelAlt}" Foreground="{StaticResource Text}"
                         BorderBrush="{StaticResource Line}" SelectionMode="Multiple"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </StackPanel>
        </Border>

        <!-- Section Label -->
        <TextBlock Grid.Row="3" Text="Filter Functions (AND logic — all conditions must match)" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,8" />

        <!-- Functions list & Actions -->
        <Grid Grid.Row="4" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Background="{StaticResource PanelAlt}" Padding="8">
                <StackPanel>
                    <ItemsControl x:Name="FunctionsList" />

                    <Button Content="+ Add condition" Style="{StaticResource Btn}" Padding="12,5" HorizontalAlignment="Left" Click="AddFunction_Click" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <Button Content="Add" Style="{StaticResource Btn}" Margin="0,0,0,8" Padding="14,6" Click="AddFunction_Click" ToolTip="Add another condition" />
                <Button Content="Clear all" Style="{StaticResource Btn}" Padding="14,6" Click="ClearAll_Click" />
            </StackPanel>
        </Grid>

        <!-- Save / Cancel -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Style="{StaticResource BtnAccent}" Padding="20,6" Margin="0,0,8,0" Click="Save_Click" />
            <Button Content="Cancel" Style="{StaticResource Btn}" Padding="16,6" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
