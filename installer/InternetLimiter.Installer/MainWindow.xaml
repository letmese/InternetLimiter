<Window x:Class="InternetLimiter.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Internet Limiter Setup"
        Height="540" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#0D1117"
        Foreground="#F0F6FC"
        FontFamily="Segoe UI"
        Icon="Assets/app.ico">
    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#238636" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#2EA043" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2EA043" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#21262D" />
                    <Setter Property="BorderBrush" Value="#30363D" />
                    <Setter Property="Foreground" Value="#484F58" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#21262D" />
            <Setter Property="Foreground" Value="#C9D1D9" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30363D" />
                    <Setter Property="Foreground" Value="#F0F6FC" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F0F6FC" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90" />
            <RowDefinition Height="*" />
            <RowDefinition Height="65" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="Assets/app_icon_256.png" Width="52" Height="52" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Internet Limiter Setup" FontSize="18" FontWeight="Bold" Foreground="#F0F6FC" />
                        <Border Background="#1F6FEB" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0.0" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Network Bandwidth Shaper, Rule Engine &amp; High-Performance Firewall" FontSize="12" Foreground="#8B949E" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY -->
        <Grid Grid.Row="1" Margin="24,18">

            <!-- CONFIGURATION PANEL -->
            <StackPanel x:Name="ConfigPanel" Visibility="Visible">
                <TextBlock Text="Destination Folder" FontSize="13" FontWeight="SemiBold" Foreground="#C9D1D9" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtInstallPath" Grid.Column="0" Height="32" Background="#0D1117" Foreground="#F0F6FC" BorderBrush="#30363D"
                             BorderThickness="1" Padding="8,5" VerticalContentAlignment="Center" FontSize="13" />
                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Height="32" Click="BtnBrowse_Click" />
                </Grid>
                <TextBlock x:Name="TxtDiskSpace" Text="Space required: ~65 MB · Space available: Calculating..." FontSize="11" Foreground="#8B949E" Margin="2,0,0,14" />

                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Installation Options" FontSize="13" FontWeight="SemiBold" Foreground="#C9D1D9" Margin="0,0,0,8" />
                        <CheckBox x:Name="ChkService" IsChecked="True">
                            <StackPanel>
                                <TextBlock Text="Install Internet Limiter Service (24/7 Background Service)" FontWeight="SemiBold" />
                                <TextBlock Text="Enforces bandwidth limits continuously and allows GUI to start instantly (&lt; 200ms) with no UAC prompts."
                                           FontSize="11" Foreground="#8B949E" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="ChkDesktopShortcut" IsChecked="True" Content="Create Desktop shortcut" Margin="0,8,0,4" />
                        <CheckBox x:Name="ChkStartMenuShortcut" IsChecked="True" Content="Create Start Menu shortcut" Margin="0,4,0,4" />
                        <CheckBox x:Name="ChkStartWithWindows" IsChecked="True" Content="Start Internet Limiter automatically when Windows boots" Margin="0,4,0,4" />
                        <CheckBox x:Name="ChkLaunchApp" IsChecked="True" Content="Launch Internet Limiter when setup finishes" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- PROGRESS PANEL -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatus" Text="Preparing installation..." FontSize="15" FontWeight="SemiBold" Foreground="#F0F6FC" Margin="0,0,0,8" />
                <ProgressBar x:Name="PrgBar" Height="14" Minimum="0" Maximum="100" Value="0" Foreground="#238636" Background="#21262D" BorderBrush="#30363D" Margin="0,0,0,12" />
                <TextBlock x:Name="TxtDetail" Text="" FontSize="12" Foreground="#8B949E" Margin="0,0,0,14" />

                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Height="140" Padding="8">
                    <ScrollViewer x:Name="ScrollLog" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtLog" Text="" FontSize="11" FontFamily="Consolas" Foreground="#8B949E" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- SUCCESS PANEL -->
            <StackPanel x:Name="SuccessPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="32" Background="#238636" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="✓" FontSize="36" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Internet Limiter has been successfully installed!" FontSize="18" FontWeight="Bold" Foreground="#F0F6FC" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="The 24/7 background service is active. Limits and rules will operate smoothly." FontSize="13" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,0,0,16" />
                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="16,12" MaxWidth="500">
                    <TextBlock Text="You can open Internet Limiter at any time from your Desktop or Start Menu. Since the background service is running, it will open instantly without UAC interruption."
                               FontSize="12" Foreground="#C9D1D9" TextWrapping="Wrap" TextAlignment="Center" />
                </Border>
            </StackPanel>

        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtFooterInfo" Grid.Column="0" Text="Administrator privileges granted" FontSize="11" Foreground="#3FB950" VerticalAlignment="Center" />
                <Button x:Name="BtnCancel" Grid.Column="1" Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="BtnCancel_Click" />
                <Button x:Name="BtnAction" Grid.Column="2" Content="Install Now" Style="{StaticResource ModernButton}" Click="BtnAction_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
