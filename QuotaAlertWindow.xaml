<Window x:Class="Valve.QuotaAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quota Status" Height="520" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="QUOTA OVERFLOW ALERT" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
            <TextBlock x:Name="PageText" Style="{StaticResource LabelText}" Margin="16,0,0,0" VerticalAlignment="Center" />
            <Button x:Name="PrevBtn" Content="◀ Prev" Style="{StaticResource Btn}" Padding="8,2" Margin="12,0,0,0" Click="Prev_Click" />
            <Button x:Name="NextBtn" Content="Next ▶" Style="{StaticResource Btn}" Padding="8,2" Margin="6,0,0,0" Click="Next_Click" />
            <Button Content="Refresh" Style="{StaticResource Btn}" Padding="8,2" Margin="6,0,0,0" Click="Refresh_Click" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="14,10,14,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="APPLICATION" Style="{StaticResource LabelText}" />
                    <TextBlock Grid.Column="1" Text="USED / QUOTA" Style="{StaticResource LabelText}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="STATUS" Style="{StaticResource LabelText}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="KILL" Style="{StaticResource LabelText}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="IGNORE / RESET" Style="{StaticResource LabelText}" HorizontalAlignment="Center" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="RowsHost" Margin="8,0,8,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding App}" Foreground="{StaticResource Text}"
                                               FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding App}" />

                                    <TextBlock Grid.Column="1" Text="{Binding QuotaText}" Foreground="{StaticResource TextDim}"
                                               FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    <Border Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{Binding StatusBrush}" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="10.5" FontWeight="Bold" />
                                    </Border>

                                    <Button Grid.Column="3" Content="Kill" Style="{StaticResource Btn}" Padding="8,2"
                                            Margin="4,2" HorizontalAlignment="Center" Click="Kill_Click" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Ignore" Style="{StaticResource Btn}" Padding="6,2"
                                                Margin="4,2" Click="Ignore_Click" />
                                        <Button Content="Reset" Style="{StaticResource Btn}" Padding="6,2"
                                                Margin="4,2" Click="Reset_Click" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Style="{StaticResource LabelText}" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="Kill terminates the process connections immediately. Ignore stops measuring this process without blocking it. Reset clears the used bytes and unblocks the application." />
    </Grid>
</Window>
