<Window x:Class="Valve.BlockerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blocker" Height="620" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <CheckBox x:Name="EnabledBox" Content="Blocker is enabled" VerticalAlignment="Center"
                      Foreground="{StaticResource Text}" Click="Enabled_Click" />
            <TextBlock Text="changes apply immediately to the Windows firewall"
                       Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="14,0,0,0" />
            <Button Content="Show pending blocker requests" Style="{StaticResource LinkBtn}"
                    Foreground="#E2604F" Margin="20,0,0,0" VerticalAlignment="Center" Click="ShowPending_Click" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="QUICK ZONE BLOCKER" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <Border Background="{StaticResource PanelAlt}" CornerRadius="4" Padding="12,6" Margin="0,0,8,0">
                        <TextBlock Text="LocalNetwork" Foreground="{StaticResource TextDim}" FontSize="12" />
                    </Border>
                    <Border Background="{StaticResource PanelAlt}" CornerRadius="4" Padding="12,6">
                        <TextBlock Text="Internet" Foreground="{StaticResource TextDim}" FontSize="12" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Internet Limiter blocks per application rather than per zone, so these are informational."
                           Style="{StaticResource LabelText}" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="14,10,14,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="APPLICATION" Style="{StaticResource LabelText}" />
                    <TextBlock Grid.Column="1" Text="IN" Style="{StaticResource LabelText}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="OUT" Style="{StaticResource LabelText}" HorizontalAlignment="Center" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="RowsHost" Margin="8,0,8,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding App}" Foreground="{StaticResource Text}"
                                               FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"
                                               TextTrimming="CharacterEllipsis" />

                                    <Button Grid.Column="1" Content="{Binding InText}" Foreground="{Binding InBrush}"
                                            Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1" Margin="4,2" Padding="0,4" FontSize="11.5"
                                            Tag="In" Click="State_Click" />

                                    <Button Grid.Column="2" Content="{Binding OutText}" Foreground="{Binding OutBrush}"
                                            Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1" Margin="4,2" Padding="0,4" FontSize="11.5"
                                            Tag="Out" Click="State_Click" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" x:Name="HintText" Style="{StaticResource LabelText}" Margin="2,10,0,0"
                   Text="click a state to cycle: Not set → Deny → Allow. Ask needs the kernel driver." />
    </Grid>
</Window>
