                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                            <Style.Triggers>
                              <DataTrigger Value="True" Binding="{Binding InRate, Converter={StaticResource RateIsActive}}">
