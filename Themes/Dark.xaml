<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         Dark Palette (Obsidian Pro - Default)
         ===================================================================== -->
    <SolidColorBrush x:Key="Bg" Color="#0B0D11" />
    <SolidColorBrush x:Key="Panel" Color="#11141A" />
    <SolidColorBrush x:Key="PanelAlt" Color="#161A22" />
    <SolidColorBrush x:Key="Line" Color="#2E3748" />
    <SolidColorBrush x:Key="Text" Color="#E6E9EF" />
