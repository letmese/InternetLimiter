<Window x:Class="Valve.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Valve.Views" Title="Internet Limiter" Icon="Assets/app.ico" Height="840" Width="1380" MinHeight="580" MinWidth="1080" WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" xmlns:valve="clr-namespace:Valve">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <ContextMenu x:Key="ProcessRowContextMenu" Style="{StaticResource DarkContextMenu}">
      <MenuItem Header="Toggle Block / Allow" Style="{StaticResource DarkMenuItem}" Click="GridBlock_Click" />
      <MenuItem Header="Terminate Active Connection(s)" Style="{StaticResource DarkMenuItem}" Click="GridKillConn_Click" />
      <MenuItem Header="Kill All Connections for App" Style="{StaticResource DarkMenuItem}" Click="MenuKillAppConnections_Click" />
      <MenuItem Header="Terminate Process" Style="{StaticResource DarkMenuItem}" Click="MenuTerminateProcess_Click" />
      <Separator />
      <MenuItem Header="🔍 Scan on VirusTotal" Style="{StaticResource DarkMenuItem}" Click="VirusTotalScan_Click" />
      <MenuItem Header="🌐 WHOIS / IP Lookup" Style="{StaticResource DarkMenuItem}" Click="WhoisLookup_Click" />
      <MenuItem Header="🗺️ View on Google Maps" Style="{StaticResource DarkMenuItem}" Click="ViewOnMap_Click" />
      <Separator />
      <MenuItem Header="Limit Download..." Style="{StaticResource DarkMenuItem}" Click="GridLimitDown_Click" />
      <MenuItem Header="Limit Upload..." Style="{StaticResource DarkMenuItem}" Click="GridLimitUp_Click" />
      <MenuItem Header="Limit Both (Coupled)..." Style="{StaticResource DarkMenuItem}" Click="GridLimitBoth_Click" />
      <MenuItem Header="Remove All Limits" Style="{StaticResource DarkMenuItem}" Click="MenuRemoveLimit_Click" />
      <MenuItem Header="Set Priority" Style="{StaticResource DarkMenuItem}">
        <MenuItem Header="Critical" Style="{StaticResource DarkMenuItem}" Tag="Critical" Click="MenuSetPriority_Click" />
        <MenuItem Header="High" Style="{StaticResource DarkMenuItem}" Tag="High" Click="MenuSetPriority_Click" />
        <MenuItem Header="Normal" Style="{StaticResource DarkMenuItem}" Tag="Normal" Click="MenuSetPriority_Click" />
        <MenuItem Header="Low" Style="{StaticResource DarkMenuItem}" Tag="Low" Click="MenuSetPriority_Click" />
      </MenuItem>
      <MenuItem Header="Copy Application Path" Style="{StaticResource DarkMenuItem}" Click="GridCopyPath_Click" />
      <Separator />
      <MenuItem Header="Move to Hidden / Unhide" Style="{StaticResource DarkMenuItem}" Click="MenuToggleHidden_Click" />
      <MenuItem Header="View Traffic Stats" Style="{StaticResource DarkMenuItem}" Click="MenuViewStats_Click" />
      <MenuItem Header="Stats Manager (Whole PC)…" Style="{StaticResource DarkMenuItem}" Click="OpenStatsManager_Click" />
      <MenuItem Header="View Connection History" Style="{StaticResource DarkMenuItem}" Click="MenuViewHistory_Click" />
      <MenuItem Header="Show app info" Style="{StaticResource DarkMenuItem}" Click="ShowAppInfo_Click" />
      <MenuItem Header="Create Filter from Selection" Style="{StaticResource DarkMenuItem}" Click="MenuCreateFilter_Click" />
    </ContextMenu>

    <ContextMenu x:Key="ConnRowContextMenu" Style="{StaticResource DarkContextMenu}">
      <MenuItem Header="🌐 WHOIS / IP Intelligence" Style="{StaticResource DarkMenuItem}" Click="WhoisLookup_Click" />
      <MenuItem Header="🗺️ View on Google Maps" Style="{StaticResource DarkMenuItem}" Click="ViewOnMap_Click" />
      <MenuItem Header="🔍 Search IP on Google" Style="{StaticResource DarkMenuItem}" Click="SearchIpWeb_Click" />
      <Separator />
      <MenuItem Header="✂️ Terminate Connection" Style="{StaticResource DarkMenuItem}" Click="GridKillConn_Click" />
      <MenuItem Header="🚫 Block This Remote IP" Style="{StaticResource DarkMenuItem}" Click="BlockConnRemote_Click" />
      <MenuItem Header="📋 Copy Remote Address" Style="{StaticResource DarkMenuItem}" Click="CopyConnRemote_Click" />
      <Separator />
      <MenuItem Header="Limit Download..." Style="{StaticResource DarkMenuItem}" Click="ConnSetLimitDown_Click" />
      <MenuItem Header="Limit Upload..." Style="{StaticResource DarkMenuItem}" Click="ConnSetLimitUp_Click" />
      <MenuItem Header="Remove Connection Limit" Style="{StaticResource DarkMenuItem}" Click="ConnRemoveLimit_Click" />
      <MenuItem Header="Set Priority" Style="{StaticResource DarkMenuItem}">
        <MenuItem Header="Critical" Style="{StaticResource DarkMenuItem}" Tag="Critical" Click="ConnSetPriority_Click" />
        <MenuItem Header="High" Style="{StaticResource DarkMenuItem}" Tag="High" Click="ConnSetPriority_Click" />
        <MenuItem Header="Normal" Style="{StaticResource DarkMenuItem}" Tag="Normal" Click="ConnSetPriority_Click" />
        <MenuItem Header="Low" Style="{StaticResource DarkMenuItem}" Tag="Low" Click="ConnSetPriority_Click" />
      </MenuItem>
      <Separator />
      <MenuItem Header="View Connection History" Style="{StaticResource DarkMenuItem}" Click="MenuViewHistory_Click" />
      <MenuItem Header="Create Filter from Selection" Style="{StaticResource DarkMenuItem}" Click="MenuCreateFilter_Click" />
    </ContextMenu>

    <ContextMenu x:Key="AppRowContextMenu" Style="{StaticResource DarkContextMenu}">
      <MenuItem Header="View Traffic Stats" Style="{StaticResource DarkMenuItem}" Click="MenuViewStats_Click" />
      <MenuItem Header="Stats Manager (Whole PC)…" Style="{StaticResource DarkMenuItem}" Click="OpenStatsManager_Click" />
      <MenuItem Header="View Connection History" Style="{StaticResource DarkMenuItem}" Click="MenuViewHistory_Click" />
      <Separator />
      <MenuItem Header="Move to Hidden / Unhide" Style="{StaticResource DarkMenuItem}" Click="MenuToggleHidden_Click" />
      <MenuItem Header="Edit Tags..." Style="{StaticResource DarkMenuItem}" Click="MenuEditTags_Click" />
      <MenuItem Header="Create Filter from Selection" Style="{StaticResource DarkMenuItem}" Click="MenuCreateFilter_Click" />
    </ContextMenu>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="34" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource TitleBarBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left: Brand, Version & Menus -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
          <Image Source="Assets/app_icon_256.png" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="INTERNET LIMITER" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
          <Border Background="#238636" CornerRadius="3" Padding="5,1" Margin="6,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding AppVersion}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
          </Border>
          <TextBlock Name="MachineText" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="6,0,12,0" />

          <Button Content="File" Style="{StaticResource MenuBtn}" Click="Menu_Click">
            <FrameworkElement.ContextMenu>
              <ContextMenu Style="{StaticResource DarkContextMenu}">
                <MenuItem Header="Open data folder" Style="{StaticResource DarkMenuItem}" Click="OpenData_Click" />
                <MenuItem Header="Settings…" Style="{StaticResource DarkMenuItem}" Click="Settings_Click" />
                <Separator />
                <MenuItem Header="Exit" Style="{StaticResource DarkMenuItem}" Click="Exit_Click" />
              </ContextMenu>
            </FrameworkElement.ContextMenu>
          </Button>
          <Button Content="Tools" Style="{StaticResource MenuBtn}" Click="Menu_Click">
            <FrameworkElement.ContextMenu>
              <ContextMenu Style="{StaticResource DarkContextMenu}">
                <MenuItem Header="Kill connections" Style="{StaticResource DarkMenuItem}" Click="KillConnections_Click" />
                <MenuItem Header="Delete rules" Style="{StaticResource DarkMenuItem}" Click="DeleteRules_Click" />
                <MenuItem Header="Block editor…" Style="{StaticResource DarkMenuItem}" Click="OpenBlocker_Click" />
                <MenuItem Header="Rule editor…" Style="{StaticResource DarkMenuItem}" Click="OpenRuleEditor_Click" />
                <Separator />
                <MenuItem Header="Stats Manager (Whole PC)…" Style="{StaticResource DarkMenuItem}" Click="OpenStatsManager_Click" />
                <MenuItem Header="Traffic Statistics Tab" Style="{StaticResource DarkMenuItem}" Click="OpenTrafficStatsTab_Click" />
                <Separator />
                <MenuItem Header="Remote connect…" Style="{StaticResource DarkMenuItem}" Click="RemoteConnect_Click" />
                <MenuItem Header="Toggle NTFS compression…" Style="{StaticResource DarkMenuItem}" Click="ToggleNtfsCompression_Click" />
                <MenuItem Header="Check for updates…" Style="{StaticResource DarkMenuItem}" Click="CheckForUpdates_Click" />
              </ContextMenu>
            </FrameworkElement.ContextMenu>
          </Button>
          <Button Content="Windows" Style="{StaticResource MenuBtn}" Click="Menu_Click">
            <FrameworkElement.ContextMenu>
              <ContextMenu Style="{StaticResource DarkContextMenu}">
                <MenuItem Header="Activity Grid" Style="{StaticResource DarkMenuItem}" Click="ToggleWindowPane_Click" Tag="Activity" />
                <MenuItem Header="Traffic Chart" Style="{StaticResource DarkMenuItem}" Click="ToggleWindowPane_Click" Tag="TrafficChart" />
                <MenuItem Header="Info Panel" Style="{StaticResource DarkMenuItem}" Click="ToggleWindowPane_Click" Tag="InfoPanel" />
                <MenuItem Header="Connection Log" Style="{StaticResource DarkMenuItem}" Click="ToggleWindowPane_Click" Tag="ConnectionLog" />
                <MenuItem Header="Traffic Statistics" Style="{StaticResource DarkMenuItem}" Click="OpenStatsManager_Click" />
                <MenuItem Header="Traffic Statistics Tab" Style="{StaticResource DarkMenuItem}" Click="OpenTrafficStatsTab_Click" />
                <Separator />
                <MenuItem Header="Float / Dock Active Tool Window" Style="{StaticResource DarkMenuItem}" Click="FloatActivePane_Click" />
                <MenuItem Header="Reset UI Layout" Style="{StaticResource DarkMenuItem}" Click="ResetLayout_Click" />
                <Separator />
                <MenuItem Header="Minimise" Style="{StaticResource DarkMenuItem}" Click="Minimise_Click" />
                <MenuItem Header="Pause monitoring" Style="{StaticResource DarkMenuItem}" Click="Pause_Click" />
                <Separator />
                <MenuItem Header="🌙  Dark (Obsidian)" Style="{StaticResource DarkMenuItem}" Click="SelectTheme_Click" Tag="Dark" />
                <MenuItem Header="⚡  Cyberpunk (Neon HUD)" Style="{StaticResource DarkMenuItem}" Click="SelectTheme_Click" Tag="Cyberpunk" />
                <MenuItem Header="☀️  Light (Modern Slate)" Style="{StaticResource DarkMenuItem}" Click="SelectTheme_Click" Tag="Light" />
              </ContextMenu>
            </FrameworkElement.ContextMenu>
          </Button>
          <Button Content="Help" Style="{StaticResource MenuBtn}" Click="Menu_Click">
            <FrameworkElement.ContextMenu>
              <ContextMenu Style="{StaticResource DarkContextMenu}">
                <MenuItem Header="About Internet Limiter" Style="{StaticResource DarkMenuItem}" Click="About_Click" />
                <MenuItem Header="Check for updates…" Style="{StaticResource DarkMenuItem}" Click="CheckForUpdates_Click" />
              </ContextMenu>
            </FrameworkElement.ContextMenu>
          </Button>
        </StackPanel>

        <!-- Center: Dragging Area (Implicit in WindowChrome) -->

        <!-- Right: Theme Switcher & Window Caption Controls -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="ThemeButton" Style="{StaticResource TitleMenuBtn}" WindowChrome.IsHitTestVisibleInChrome="True" Click="ThemeButton_Click" ToolTip="Change visual theme (Dark, Cyberpunk, Light)" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="ThemeIconText" Text="🌙" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
              <TextBlock x:Name="ThemeLabelText" Text="Dark (Obsidian)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
              <Path Data="M 0,0 L 3.5,3.5 L 7,0" Stroke="{DynamicResource TextDim}" StrokeThickness="1.2" Margin="6,1,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button.ContextMenu>
              <ContextMenu Style="{StaticResource DarkContextMenu}">
                <MenuItem Header="🌙  Dark (Obsidian)" Style="{StaticResource DarkMenuItem}" Click="SelectTheme_Click" Tag="Dark" />
                <MenuItem Header="⚡  Cyberpunk (Neon HUD)" Style="{StaticResource DarkMenuItem}" Click="SelectTheme_Click" Tag="Cyberpunk" />
                <MenuItem Header="☀️  Light (Modern Slate)" Style="{StaticResource DarkMenuItem}" Click="SelectTheme_Click" Tag="Light" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>

          <Border BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Height="22" VerticalAlignment="Center" Margin="0,0,2,0" />

          <Button Style="{StaticResource WindowMinBtn}" ToolTip="Minimize" Click="TitleMin_Click" />
          <Button Name="MaximizeButton" Style="{StaticResource WindowMaxBtn}" ToolTip="Maximize" Click="TitleMax_Click" />
          <Button Style="{StaticResource WindowCloseBtn}" ToolTip="Close" Click="TitleClose_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Application Toolbar -->
    <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,6,12,6">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Units" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox Name="UnitsBox" Width="68" Height="28" VerticalAlignment="Center"
                    Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Text}"
                    BorderBrush="{DynamicResource Line}" SelectionChanged="Units_Changed">
            <ComboBoxItem Content="Auto" Tag="auto" IsSelected="True" />
            <ComboBoxItem Content="B" Tag="bytes" />
            <ComboBoxItem Content="bit" Tag="bits" />
            <ComboBoxItem Content="KB" Tag="kilo" />
            <ComboBoxItem Content="MB" Tag="mega" />
          </ComboBox>

          <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="12,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="6" Height="6" Fill="#F85149" Margin="0,0,5,0" />
              <CheckBox Name="BlockerToggle" Content="Blocker: OFF" IsChecked="False" VerticalAlignment="Center"
                        Foreground="{DynamicResource Text}" FontSize="11" FontWeight="SemiBold" Click="GlobalToggle_Click" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="6,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="6" Height="6" Fill="#35D39A" Margin="0,0,5,0" />
              <CheckBox Name="LimiterToggle" Content="Limiter: OFF" IsChecked="False" VerticalAlignment="Center"
                        Foreground="{DynamicResource Text}" FontSize="11" FontWeight="SemiBold" Click="GlobalToggle_Click" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="6,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="6" Height="6" Fill="#58A6FF" Margin="0,0,5,0" />
              <CheckBox Name="PriorityToggle" Content="Priorities: OFF" IsChecked="False" VerticalAlignment="Center"
                        Foreground="{DynamicResource Text}" FontSize="11" FontWeight="SemiBold" Click="GlobalToggle_Click" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="6,0,0,0" ToolTip="Global Line Speed (Auto-detected / Configured)">
            <TextBlock Text="{Binding LineSpeedText}" FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
          </Border>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBox Name="SearchBox" Style="{StaticResource InputBox}" Width="160" Height="28"
                   ToolTip="Quick filter (Ctrl+F)" TextChanged="SearchBox_TextChanged" />
          <Button Name="PauseButton" Content="⏸ Pause" Style="{StaticResource Btn}" Padding="9,4" Margin="6,0,0,0" Click="Pause_Click" />
          <Button Name="SnapshotButton" Content="📸 Snapshot" Style="{StaticResource Btn}"
                  Padding="9,4" Margin="6,0,0,0" Click="Snapshot_Click" />
          <Button Name="EmergencyBlockButton" Content="🚫 Emergency Block" Style="{StaticResource BtnDanger}"
                  Padding="10,4" Margin="6,0,0,0" Click="EmergencyBlock_Click" />
          <Button Content="📊 Stats Manager" Style="{StaticResource Btn}"
                  Padding="10,4" Margin="6,0,0,0" Click="OpenStatsManager_Click"
                  ToolTip="View comprehensive historical traffic stats for the whole PC &amp; all applications" />
          <Button Content="⚙ Settings" Style="{StaticResource BtnAccent}"
                  Padding="10,4" Margin="6,0,0,0" Click="Settings_Click" />

          <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="4,2" Margin="8,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <RadioButton x:Name="ThemeRadioDark" Content="🌙 Dark" GroupName="ToolbarThemeGroup" Style="{StaticResource Chip}" Margin="1,0" Click="ThemeRadio_Click" Tag="Dark" IsChecked="True" ToolTip="Obsidian Dark theme" />
              <RadioButton x:Name="ThemeRadioCyber" Content="⚡ Cyber" GroupName="ToolbarThemeGroup" Style="{StaticResource Chip}" Margin="2,0" Click="ThemeRadio_Click" Tag="Cyberpunk" ToolTip="Cyberpunk Neon HUD theme" />
              <RadioButton x:Name="ThemeRadioLight" Content="☀️ Light" GroupName="ToolbarThemeGroup" Style="{StaticResource Chip}" Margin="1,0" Click="ThemeRadio_Click" Tag="Light" ToolTip="Modern Light Slate theme" />
            </StackPanel>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="420" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="420" MinWidth="340" />
      </Grid.ColumnDefinitions>
      <TabControl Name="Tabs" Grid.Column="0" Background="#00FFFFFF" BorderThickness="0" Margin="10,8,4,0">
        <TabItem Header="Activity">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,4,0,8">
              <DockPanel LastChildFill="False">
              <RadioButton Name="ChipAll" DockPanel.Dock="Left" Style="{StaticResource Chip}" IsChecked="True" Content="{Binding AllCountText}" Checked="Chip_Changed" />
              <RadioButton Name="ChipOnline" DockPanel.Dock="Left" Style="{StaticResource Chip}" Margin="4,0,0,0" Content="{Binding OnlineCountText}" Checked="Chip_Changed" />
              <RadioButton Name="ChipOffline" DockPanel.Dock="Left" Style="{StaticResource Chip}" Margin="4,0,0,0" Content="{Binding OfflineCountText}" Checked="Chip_Changed" />
              <RadioButton Name="ChipBlocked" DockPanel.Dock="Left" Style="{StaticResource Chip}" Margin="4,0,0,0" Content="{Binding BlockedCountText}" Checked="Chip_Changed" />
              <RadioButton Name="ChipHidden" DockPanel.Dock="Left" Style="{StaticResource Chip}" Margin="4,0,0,0" Content="{Binding HiddenCountText}" Checked="Chip_Changed" />
              <ComboBox Name="SortBox" DockPanel.Dock="Right" Width="92" SelectedIndex="0" Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Line}" Margin="8,0,0,0" SelectionChanged="SortBox_SelectionChanged">
                <ComboBoxItem Content="Rate" />
                <ComboBoxItem Content="Name" />
                <ComboBoxItem Content="Status" />
              </ComboBox>
              <Button DockPanel.Dock="Right" Content="Columns &#x2699;" Style="{StaticResource Btn}" Padding="8,3" Margin="4,0,0,0" Click="CustomizeColumns_Click" ToolTip="Customize visible columns and options" />
              <Button DockPanel.Dock="Right" Content="Reset Totals" Style="{StaticResource Btn}" Padding="8,3" Margin="4,0,0,0" Click="ResetTotals_Click" ToolTip="Reset all session transfer counters" />
              <Button DockPanel.Dock="Right" Content="↕ Collapse All" Style="{StaticResource Btn}" Padding="8,3" Margin="4,0,0,0" Click="CollapseAll_Click" />
              <Button DockPanel.Dock="Right" Content="↕ Expand All" Style="{StaticResource Btn}" Padding="8,3" Margin="4,0,0,0" Click="ExpandAll_Click" />
              <Button x:Name="AutoScrollButton" DockPanel.Dock="Right" Style="{StaticResource Btn}" Padding="8,3" Margin="6,0,0,0" Click="AutoScrollButton_Click" ToolTip="Toggle automatic scrolling to active or selected process">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Ellipse x:Name="AutoScrollDot" Width="6" Height="6" Fill="{DynamicResource Down}" Margin="0,0,5,0" VerticalAlignment="Center" />
                  <TextBlock x:Name="AutoScrollText" Text="Auto-scroll: ON" Foreground="{DynamicResource Text}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DockPanel>
            </Border>
            <DataGrid Name="ProcessGrid" RowHeight="25" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" CanUserSortColumns="True" HeadersVisibility="Column" SelectionMode="Extended" SelectionUnit="FullRow" GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource Line}" VerticalGridLinesBrush="{DynamicResource Line}" ItemsSource="{Binding TreeRows}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}" Sorting="ProcessGrid_Sorting" MouseDoubleClick="ProcessGrid_MouseDoubleClick" SelectionChanged="ProcessGrid_SelectionChanged">
              <DataGrid.RowStyle>
                <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="{x:Type DataGridRow}">
                  <Setter Property="ContextMenu" Value="{StaticResource ProcessRowContextMenu}" />

                </Style>
              </DataGrid.RowStyle>
              <DataGrid.Resources>
                <ContextMenu x:Key="ColumnHeaderMenu" Opened="ColumnHeaderContextMenu_Opened">
                  <MenuItem Header="Options / Customize Columns..." FontWeight="Bold" Click="CustomizeColumns_Click" />
                  <Separator />
                  <MenuItem Header="Name" IsCheckable="True" Tag="ColName" Click="MenuColToggle_Click" />
                  <MenuItem Header="RateIn (DL Rate)" IsCheckable="True" Tag="ColDlRate" Click="MenuColToggle_Click" />
                  <MenuItem Header="RateOut (UL Rate)" IsCheckable="True" Tag="ColUlRate" Click="MenuColToggle_Click" />
                  <MenuItem Header="LimitIn (DL Limit)" IsCheckable="True" Tag="ColDlLimit" Click="MenuColToggle_Click" />
                  <MenuItem Header="LimitOut (UL Limit)" IsCheckable="True" Tag="ColUlLimit" Click="MenuColToggle_Click" />
                  <MenuItem Header="TotalIn (DL Total)" IsCheckable="True" Tag="ColDlTotal" Click="MenuColToggle_Click" />
                  <MenuItem Header="TotalOut (UL Total)" IsCheckable="True" Tag="ColUlTotal" Click="MenuColToggle_Click" />
                  <MenuItem Header="FwIn (In Fw)" IsCheckable="True" Tag="ColInFw" Click="MenuColToggle_Click" />
                  <MenuItem Header="FwOut (Out Fw)" IsCheckable="True" Tag="ColOutFw" Click="MenuColToggle_Click" />
                  <MenuItem Header="Status" IsCheckable="True" Tag="ColStatus" Click="MenuColToggle_Click" />
                </ContextMenu>
              </DataGrid.Resources>
              <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                  <Setter Property="ContextMenu" Value="{StaticResource ColumnHeaderMenu}" />
                </Style>
              </DataGrid.ColumnHeaderStyle>
              <DataGrid.Columns>
                <DataGridTemplateColumn x:Name="ColName" Header="Name" Width="280" SortMemberPath="Name">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{Binding Indent, Converter={StaticResource IndentMargin}}" ToolTip="{Binding Path}">
                        <!-- Reserved 18px Expander Slot -->
                        <Border Width="18" Height="18" Margin="0,0,2,0" VerticalAlignment="Center">
                          <Button Style="{StaticResource ExpanderBtn}" Width="18" Height="18" MinWidth="18" MinHeight="18" VerticalAlignment="Center" HorizontalAlignment="Center" Content="{Binding ExpanderGlyph}" Visibility="{Binding CanExpand, Converter={StaticResource BoolToVis}}" Click="Toggle_Click" ToolTip="Click to expand or collapse details" />
                        </Border>
                        <!-- Reserved 18px Icon Slot -->
                        <Border Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center">
                          <Image Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Icon}" MouseLeftButtonUp="Toggle_Click" Cursor="Hand" />
                        </Border>
                        <!-- Prominent & Bold App / Process / Connection Name -->
                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}">
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type TextBlock}">
                              <Setter Property="Foreground" Value="{DynamicResource Text}" />
                              <Setter Property="FontWeight" Value="SemiBold" />
                              <Setter Property="FontSize" Value="12" />
                              <Style.Triggers>
                                <DataTrigger Value="True" Binding="{Binding IsConnection}">
                                  <Setter Property="Foreground" Value="{DynamicResource Down}" />
                                  <Setter Property="FontFamily" Value="Segoe UI, Consolas" />
                                  <Setter Property="FontWeight" Value="Normal" />
                                  <Setter Property="FontSize" Value="11.5" />
                                </DataTrigger>
                                <DataTrigger Value="True" Binding="{Binding IsSubProcess}">
                                  <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                  <Setter Property="FontWeight" Value="SemiBold" />
                                  <Setter Property="FontSize" Value="11.5" />
                                </DataTrigger>
                                <DataTrigger Value="True" Binding="{Binding IsRoot}">
                                  <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                  <Setter Property="FontWeight" Value="Bold" />
                                  <Setter Property="FontSize" Value="12" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Process.AppTypeBadge}" Foreground="{DynamicResource TextDim}" FontSize="9.5" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding Subtitle}">
                          <FrameworkElement.Style>
                            <Style BasedOn="{StaticResource MonoText}" TargetType="{x:Type TextBlock}">
                              <Setter Property="FontSize" Value="10.5" />
                              <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                              <Style.Triggers>
                                <DataTrigger Value="True" Binding="{Binding IsConnection}">
                                  <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                                  <Setter Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Value="True" Binding="{Binding IsAppOrGroup}">
                                  <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
