                        <TextBlock Text="{Binding SelectedOutRateText}" FontFamily="Consolas" FontSize="17" FontWeight="Bold" Foreground="#58A6FF" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>
                  </UniformGrid>

                  <!-- Expanded Waveform Graph Canvas -->
                  <Border Height="130" Background="#0C1017" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                    <views:TrafficGraph x:Name="Graph" />
                  </Border>

                  <!-- Time Scale Legend -->
                  <DockPanel Margin="2,6,2,0">
                    <TextBlock DockPanel.Dock="Left" Text="-60s" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}" FontFamily="Consolas" />
                    <TextBlock DockPanel.Dock="Right" Text="Now (0s)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}" FontFamily="Consolas" HorizontalAlignment="Right" />
                    <TextBlock Text="-30s" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}" FontFamily="Consolas" HorizontalAlignment="Center" />
                  </DockPanel>
                </StackPanel>
              </Border>
            </StackPanel>
            <Border Name="SecFirewall" Visibility="Collapsed" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Firewall Rule State" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,0,0,8" />
                <UniformGrid Columns="2" Margin="0,0,0,8">
                  <Border Background="{DynamicResource PanelAlt}" BorderBrush="#238636" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,4,0">
                    <StackPanel>
                      <TextBlock Text="INBOUND TRAFFIC" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextDim}" Margin="0,0,0,2" />
                      <TextBlock Text="{Binding FirewallInStateText}" FontWeight="Bold" FontSize="11" Foreground="#35D39A" />
                    </StackPanel>
                  </Border>
                  <Border Background="{DynamicResource PanelAlt}" BorderBrush="#238636" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="4,0,0,0">
                    <StackPanel>
                      <TextBlock Text="OUTBOUND TRAFFIC" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextDim}" Margin="0,0,0,2" />
                      <TextBlock Text="{Binding FirewallOutStateText}" FontWeight="Bold" FontSize="11" Foreground="#35D39A" />
                    </StackPanel>
                  </Border>
                </UniformGrid>
                <CheckBox Content="Prompt / Ask on new remote endpoint" FontSize="11" Foreground="{DynamicResource TextDim}" Margin="0,0,0,8" IsChecked="{Binding AskOnNewEndpoint, Mode=TwoWay}" />
                <UniformGrid Columns="2">
                  <Button Content="+ Add Rule" Style="{StaticResource Btn}" Margin="0,0,4,0" Padding="0,4" Click="OpenRuleEditor_Click" />
                  <Button Content="Clear Rules" Style="{StaticResource Btn}" Margin="4,0,0,0" Padding="0,4" Click="DeleteRules_Click" />
                </UniformGrid>
              </StackPanel>
            </Border>
            <Border Name="SecBandwidth" Visibility="Collapsed" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
              <StackPanel>
                <DockPanel Margin="0,0,0,8">
                  <Border DockPanel.Dock="Right" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="3" Padding="5,1">
                    <TextBlock Text="Active Profile" FontSize="10" Foreground="#35D39A" />
                  </Border>
                  <TextBlock Text="Bandwidth Shaper" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Text}" />
                </DockPanel>
                <DockPanel Margin="0,5,0,3">
                  <CheckBox DockPanel.Dock="Left" Content="Download Cap" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource Text}" VerticalAlignment="Center" IsChecked="{Binding SelectedProcess.IsDownloadLimitEnabled, Mode=OneWay}" Click="SideDownloadLimitToggle_Click" ToolTip="Toggle download cap without deleting limit" />
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox Name="DownCapBox" Style="{StaticResource InputBox}" Width="95" Height="26" FontSize="12.5" FontWeight="SemiBold" Padding="6,2" VerticalContentAlignment="Center" Text="{Binding SelectedProcess.DownloadLimitKBps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="DownCapBox_KeyDown" ToolTip="Download limit in KB/s (Enter to set)" />
                    <TextBlock Text="KB/s" Foreground="{DynamicResource TextFaint}" FontSize="10.5" VerticalAlignment="Center" Margin="4,0,6,0" />
                    <Button Content="Set" Style="{StaticResource Btn}" Padding="8,2" Height="26" Margin="0,0,0,0" Click="DownCapSet_Click" />
                  </StackPanel>
                </DockPanel>
                <Border Height="4" Background="{DynamicResource PanelAlt}" CornerRadius="2" Margin="0,4,0,6">
                  <ProgressBar Minimum="0" Maximum="100" Value="{Binding SelectedProcess.DownloadUtilizationPercent}" Background="#00FFFFFF" Foreground="#35D39A" BorderThickness="0" />
                </Border>
                <DockPanel Margin="0,5,0,3">
                  <CheckBox DockPanel.Dock="Left" Content="Upload Cap" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource Text}" VerticalAlignment="Center" IsChecked="{Binding SelectedProcess.IsUploadLimitEnabled, Mode=OneWay}" Click="SideUploadLimitToggle_Click" ToolTip="Toggle upload cap without deleting limit" />
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox Name="CapBox" Style="{StaticResource InputBox}" Width="95" Height="26" FontSize="12.5" FontWeight="SemiBold" Padding="6,2" VerticalContentAlignment="Center" Text="{Binding SelectedProcess.LimitKBps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="CapBox_KeyDown" ToolTip="Upload limit in KB/s (Enter to set)" />
                    <TextBlock Text="KB/s" Foreground="{DynamicResource TextFaint}" FontSize="10.5" VerticalAlignment="Center" Margin="4,0,6,0" />
                    <Button Content="Set" Style="{StaticResource Btn}" Padding="8,2" Height="26" Margin="0,0,0,0" Click="CapSet_Click" />
                  </StackPanel>
                </DockPanel>
                <Border Height="4" Background="{DynamicResource PanelAlt}" CornerRadius="2" Margin="0,4,0,8">
                  <ProgressBar Minimum="0" Maximum="100" Value="{Binding SelectedProcess.UploadUtilizationPercent}" Background="#00FFFFFF" Foreground="#58A6FF" BorderThickness="0" />
                </Border>
                <Button Content="Couple Both Limits" Style="{StaticResource Btn}" Margin="0,0,0,8" Click="SideCoupleLimits_Click" ToolTip="Apply same limit to Download and Upload (Item 1.03)" />
              </StackPanel>
            </Border>
            <Border Name="SecRules" Visibility="Collapsed" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="PROCESS RULES &amp; POLICIES" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="In" Style="{StaticResource LabelText}" />
                  <TextBlock Grid.Row="0" Grid.Column="2" Text="Out" Style="{StaticResource LabelText}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Blocker" Foreground="{DynamicResource TextDim}" FontSize="11.5" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource Text}" FontSize="11.5" VerticalAlignment="Center" Text="{Binding RuleBlockerIn}" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Foreground="{DynamicResource Text}" FontSize="11.5" VerticalAlignment="Center" Text="{Binding RuleBlockerOut}" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Limit" Foreground="{DynamicResource TextDim}" FontSize="11.5" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource Text}" FontSize="11.5" VerticalAlignment="Center" Text="{Binding RuleLimitIn}" />
                  <TextBlock Grid.Row="2" Grid.Column="2" Foreground="{DynamicResource TextFaint}" FontSize="11.5" VerticalAlignment="Center" Text="{Binding RuleLimitOut}" />
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Priority" Foreground="{DynamicResource TextDim}" FontSize="11.5" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Foreground="{DynamicResource Text}" FontSize="11.5" VerticalAlignment="Center" Text="{Binding RulePriorityIn}" />
                  <TextBlock Grid.Row="3" Grid.Column="2" Foreground="{DynamicResource TextFaint}" FontSize="11.5" VerticalAlignment="Center" Text="{Binding RulePriorityOut}" />
                </Grid>
                <UniformGrid Columns="2">
                  <Button Content="Rule editor…" Style="{StaticResource Btn}" Margin="0,0,4,0" Padding="0,4" Click="OpenRuleEditor_Click" />
                  <Button Content="Pending requests…" Style="{StaticResource Btn}" Margin="4,0,0,0" Padding="0,4" Click="OpenPendingRequests_Click" />
                </UniformGrid>
              </StackPanel>
            </Border>
            <Button Style="{StaticResource BtnDanger}" HorizontalAlignment="Stretch" Height="38" Padding="12,6" Margin="0,0,0,6" Click="KillConnections_Click">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="&#x1F6AB;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Text="{Binding KillButtonText}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
      <DockPanel Margin="14,6">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Diagnostics" Style="{StaticResource LinkBtn}" Margin="0,0,10,0" Click="Diagnostics_Click" />
          <Button Content="Logs" Style="{StaticResource LinkBtn}" Margin="0,0,12,0" Click="Logs_Click" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="6" Height="6" Fill="#35D39A" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock Style="{StaticResource MonoText}" FontSize="11" Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding ActiveAdapterSummary}" ToolTip="Current active network adapter (Click to switch)" Cursor="Hand" MouseLeftButtonUp="ActiveAdapter_Click" />
          <Button Content="[ ⇄ Switch Adapter ]" Style="{StaticResource LinkBtn}" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center" Click="SwitchAdapter_Click" ToolTip="Select or switch active network adapter" />
          <TextBlock Name="EnvironmentText" Style="{StaticResource MonoText}" FontSize="11" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,14,0" />
          <TextBlock Name="StatusText" Style="{StaticResource MonoText}" FontSize="11" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
