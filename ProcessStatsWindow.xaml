<Window x:Class="Valve.ProcessStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Statistics — Process" Height="620" Width="780"
        MinHeight="480" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,8,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource HoverBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Down}" />
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SelectionBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Process Header -->
        <Border Grid.Row="0" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,14">
            <DockPanel LastChildFill="True">
                <Image Name="AppIconImg" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Name="AppNameText" Text="Process Name" FontWeight="Bold" FontSize="17" Foreground="{DynamicResource Text}" />
                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Name="PidText" Text="PID: 0" FontSize="11" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" />
                        </Border>
                        <Border Name="StatusBadge" Background="#1B382B" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Name="StatusBadgeText" Text="ACTIVE" FontSize="10.5" Foreground="{DynamicResource Down}" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Name="AppPathText" Text="C:\Program Files\..." FontSize="11" Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 4 Metric Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Total In -->
            <Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TOTAL DOWNLOAD" Style="{StaticResource LabelText}" Opacity="0.75" FontSize="10" />
                    <TextBlock Name="TotalInText" Text="0 B" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Down}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Total Out -->
            <Border Grid.Column="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TOTAL UPLOAD" Style="{StaticResource LabelText}" Opacity="0.75" FontSize="10" />
                    <TextBlock Name="TotalOutText" Text="0 B" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Up}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- DL Speed -->
            <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="CURRENT DL SPEED" Style="{StaticResource LabelText}" Opacity="0.75" FontSize="10" />
                    <TextBlock Name="InRateText" Text="0 B/s" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- UL Speed -->
            <Border Grid.Column="3" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="CURRENT UL SPEED" Style="{StaticResource LabelText}" Opacity="0.75" FontSize="10" />
                    <TextBlock Name="OutRateText" Text="0 B/s" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content Area: Tabs -->
        <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12">
            <TabControl Background="Transparent" BorderThickness="0">
                <!-- Tab 1: Active Connections -->
                <TabItem Header="Active Connections" Style="{StaticResource DarkTabItem}">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Name="ConnCountText" Text="0 active sockets" Foreground="{DynamicResource TextDim}" FontSize="11.5" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid Name="ConnsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" Background="Transparent" RowHeight="26"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Line}"
                                  HeadersVisibility="Column" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Dir" Width="55" Binding="{Binding DirectionBadge}" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Protocol" Width="65" Binding="{Binding Proto}" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Local Endpoint" Width="140" Binding="{Binding Local}" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Remote Endpoint" Width="180" Binding="{Binding Remote}" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Location" Width="100" Binding="{Binding Location}" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="DL Speed" Width="95" Binding="{Binding InRateText}" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="UL Speed" Width="95" Binding="{Binding OutRateText}" ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Limits & Traffic Rules -->
                <TabItem Header="Limits &amp; Rules" Style="{StaticResource DarkTabItem}">
                    <Grid Margin="0,14,0,0">
                        <StackPanel>
                            <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Download Limit:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                                    <TextBlock Name="DlLimitSummaryText" Grid.Column="1" Text="No limit (unthrottled)" FontSize="13" Foreground="{DynamicResource Down}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="Edit Limit..." Style="{StaticResource Btn}" Padding="8,4" Click="EditDlLimit_Click" />
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Upload Limit:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                                    <TextBlock Name="UlLimitSummaryText" Grid.Column="1" Text="No limit (unthrottled)" FontSize="13" Foreground="{DynamicResource Up}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="Edit Limit..." Style="{StaticResource Btn}" Padding="8,4" Click="EditUlLimit_Click" />
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Priority Level:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                                    <TextBlock Name="PrioritySummaryText" Grid.Column="1" Text="Normal" FontSize="13" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Footer Actions -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Set Limit..." Style="{StaticResource Btn}" Background="{DynamicResource Down}"
                        Foreground="#0B0D11" FontWeight="Bold" Padding="14,6" Height="32" Margin="0,0,8,0" Click="OpenSetLimit_Click" />
                <Button Content="Export to CSV" Style="{StaticResource Btn}" Padding="12,6" Height="32" Click="ExportCsv_Click" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource Btn}" Padding="18,6" Height="32"
                    HorizontalAlignment="Right" IsCancel="True" Click="Close_Click" />
        </DockPanel>
    </Grid>
</Window>
