                        <TextBlock Style="{StaticResource CellText}" FontSize="11" Foreground="{DynamicResource Text}" FontWeight="Normal" VerticalAlignment="Center" Text="{Binding DownloadLimitText}" Cursor="Hand" ToolTip="Click to edit download limit" MouseLeftButtonUp="GridLimitDlCell_Click" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="ColUlLimit" Width="105" SortMemberPath="UL Limit">
                  <DataGridColumn.Header>
                    <StackPanel HorizontalAlignment="Left" Margin="6,0,0,0">
                      <TextBlock Text="UL Limit" FontWeight="SemiBold" Foreground="{DynamicResource Text}" FontSize="11.5" />
                      <TextBlock Text="Auto Units" FontSize="9" Foreground="{DynamicResource TextFaint}" />
                    </StackPanel>
                  </DataGridColumn.Header>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="6,0,0,0" VerticalAlignment="Center">
                        <CheckBox VerticalAlignment="Center" Margin="0,0,6,0" IsChecked="{Binding IsUploadLimitEnabled, Mode=OneWay}" Visibility="{Binding IsNotConnection, Converter={StaticResource BoolToVis}}" Click="GridLimitToggleUl_Click" ToolTip="Toggle upload limit on/off without clearing limit value" />
                        <TextBlock Style="{StaticResource CellText}" FontSize="11" Foreground="{DynamicResource Text}" FontWeight="Normal" VerticalAlignment="Center" Text="{Binding LimitText}" Cursor="Hand" ToolTip="Click to edit upload limit" MouseLeftButtonUp="GridLimitUlCell_Click" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="ColDlTotal" Width="95" SortMemberPath="DL Total">
                  <DataGridColumn.Header>
                    <StackPanel HorizontalAlignment="Left" Margin="6,0,0,0">
                      <TextBlock Text="DL Total" FontWeight="SemiBold" Foreground="{DynamicResource Text}" FontSize="11.5" />
                      <TextBlock Text="Auto Units" FontSize="9" Foreground="{DynamicResource TextFaint}" />
                    </StackPanel>
                  </DataGridColumn.Header>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock FontFamily="Segoe UI" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Down}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0" Text="{Binding InTotalText}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="ColUlTotal" Width="95" SortMemberPath="UL Total">
                  <DataGridColumn.Header>
                    <StackPanel HorizontalAlignment="Left" Margin="6,0,0,0">
                      <TextBlock Text="UL Total" FontWeight="SemiBold" Foreground="{DynamicResource Text}" FontSize="11.5" />
                      <TextBlock Text="Auto Units" FontSize="9" Foreground="{DynamicResource TextFaint}" />
                    </StackPanel>
                  </DataGridColumn.Header>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock FontFamily="Segoe UI" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0" Text="{Binding OutTotalText}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="ColInFw" Header="In Fw" Width="55" SortMemberPath="In Fw">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Blocked, Mode=OneWay}" Visibility="{Binding IsNotConnection, Converter={StaticResource BoolToVis}}" Click="GridFw_Click" ToolTip="Toggle Inbound Block" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="ColOutFw" Header="Out Fw" Width="55" SortMemberPath="Out Fw">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Blocked, Mode=OneWay}" Visibility="{Binding IsNotConnection, Converter={StaticResource BoolToVis}}" Click="GridFw_Click" ToolTip="Toggle Outbound Block" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="ColStatus" Header="Status" Width="70" SortMemberPath="Status">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="●" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center">
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type TextBlock}">
                              <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                              <Style.Triggers>
                                <DataTrigger Value="True" Binding="{Binding IsOnline}">
                                  <Setter Property="Foreground" Value="{DynamicResource Down}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                        </TextBlock>
                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="3" Padding="3,1" Margin="0,0,3,0" ToolTip="Download limit active" Visibility="{Binding HasDownloadLimit, Converter={StaticResource BoolToVis}}">
                          <TextBlock Text="↓" FontSize="10" Foreground="{DynamicResource Accent}" FontWeight="Bold" />
                        </Border>
                        <Border Background="{DynamicResource SelectionBg}" CornerRadius="3" Padding="3,1" Margin="0,0,3,0" ToolTip="Upload limit active" Visibility="{Binding HasUploadLimit, Converter={StaticResource BoolToVis}}">
                          <TextBlock Text="↑" FontSize="10" Foreground="{DynamicResource Warn}" FontWeight="Bold" />
                        </Border>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}" Padding="0,6,0,4" Margin="0,6,0,0">
              <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="Filtered view" Style="{StaticResource LabelText}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right" />
              <TextBlock Name="NoteText" Foreground="{DynamicResource Warn}" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>
            </Border>
          </Grid>
        </TabItem>
        <TabItem Header="Connections">
          <DataGrid Name="ConnGrid" RowHeight="34" GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource Line}" VerticalGridLinesBrush="{DynamicResource Line}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Margin="0,6,0,0">
            <DataGrid.RowStyle>
              <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="{x:Type DataGridRow}">
                <Setter Property="ContextMenu" Value="{StaticResource ConnRowContextMenu}" />
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="process" Width="150" ElementStyle="{StaticResource CellText}" Binding="{Binding Process}" />
              <DataGridTextColumn Header="proto" Width="60" ElementStyle="{StaticResource CellText}" Binding="{Binding Proto}" />
              <DataGridTextColumn Header="remote" Width="175" ElementStyle="{StaticResource CellText}" Binding="{Binding Remote}" />
              <DataGridTextColumn Header="location" Width="165" ElementStyle="{StaticResource CellText}" Binding="{Binding Location}" />
              <DataGridTextColumn Header="local" Width="165" ElementStyle="{StaticResource CellText}" Binding="{Binding Local}" />
