<Application x:Class="InternetLimiter.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="App_Startup">
    <Application.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#0D1117" />
        <SolidColorBrush x:Key="CardBg" Color="#161B22" />
        <SolidColorBrush x:Key="BorderBrush" Color="#30363D" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F6FC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#8B949E" />
        <SolidColorBrush x:Key="AccentBlue" Color="#388BFD" />
        <SolidColorBrush x:Key="AccentGreen" Color="#238636" />
        <SolidColorBrush x:Key="AccentGreenHover" Color="#2EA043" />
    </Application.Resources>
</Application>
