<Window x:Class="Valve.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Internet Limiter Notification" Height="130" Width="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual">
  <Border Background="#1C2128" BorderBrush="#30363D" BorderThickness="1.5" CornerRadius="8" Margin="6" Padding="14,10">
    <Border.Effect>
      <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.55" Color="#000000" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header -->
      <DockPanel Grid.Row="0">
        <Button DockPanel.Dock="Right" Content="✕" Width="20" Height="20" Background="Transparent" BorderThickness="0" Foreground="#8B949E" FontSize="11" Click="Close_Click" Cursor="Hand" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Name="StatusDot" Width="8" Height="8" Fill="#F85149" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock Name="TitleText" Text="Connection Blocked" FontWeight="Bold" FontSize="11.5" Foreground="#F0F6FC" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>

      <!-- Message -->
      <TextBlock Name="MessageText" Grid.Row="1" Text="Process attempted an outbound connection to remote destination." Foreground="#C9D1D9" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,6" VerticalAlignment="Center" />

      <!-- Action Buttons -->
      <StackPanel Name="ActionPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Name="SecondaryBtn" Content="Remember" Padding="10,2" Margin="0,0,6,0" FontSize="10.5" Background="#21262D" Foreground="#C9D1D9" BorderBrush="#30363D" Click="Secondary_Click" />
        <Button Name="PrimaryBtn" Content="Dismiss" Padding="10,2" FontSize="10.5" Background="#238636" Foreground="#FFFFFF" BorderThickness="0" Click="Primary_Click" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
