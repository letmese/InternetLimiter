<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         Light Palette (NetLimiter High-Visibility & Modern Clarity)
         ===================================================================== -->
    <SolidColorBrush x:Key="Bg" Color="#F4F6F9" />
    <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelAlt" Color="#F8FAFC" />
    <SolidColorBrush x:Key="Line" Color="#CBD5E1" />
    <SolidColorBrush x:Key="Text" Color="#0F172A" />
    <SolidColorBrush x:Key="TextDim" Color="#334155" />
    <SolidColorBrush x:Key="TextFaint" Color="#94A3B8" />
    <SolidColorBrush x:Key="Accent" Color="#16A34A" />
    <SolidColorBrush x:Key="AccentSoft" Color="#DCFCE7" />
    <SolidColorBrush x:Key="Down" Color="#0284C7" />
    <SolidColorBrush x:Key="Up" Color="#0F172A" />
    <SolidColorBrush x:Key="Warn" Color="#D97706" />
    <SolidColorBrush x:Key="Bad" Color="#DC2626" />

    <SolidColorBrush x:Key="HoverBg" Color="#F1F5F9" />
    <SolidColorBrush x:Key="SelectionBg" Color="#E0F2FE" />
    <SolidColorBrush x:Key="SelectionBorder" Color="#7DD3FC" />
    <SolidColorBrush x:Key="TitleBarBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TitleBarBtnHover" Color="#F1F5F9" />
    <SolidColorBrush x:Key="DataGridRowAlt" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderBg" Color="#F8FAFC" />
    <SolidColorBrush x:Key="HeaderBorder" Color="#CBD5E1" />
    <SolidColorBrush x:Key="TabActiveBg" Color="#16A34A" />
    <SolidColorBrush x:Key="TabActiveFg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ChipCheckedBg" Color="#16A34A" />
    <SolidColorBrush x:Key="ChipCheckedFg" Color="#FFFFFF" />
</ResourceDictionary>
