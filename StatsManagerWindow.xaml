<Window x:Class="Valve.StatsManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Internet Limiter — Stats Manager" Height="760" Width="880" MinHeight="560" MinWidth="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: database overview -->
        <Border Grid.Row="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="DAY FILES" Style="{StaticResource LabelText}" Opacity="0.7" />
                    <TextBlock Name="DayCountText" Style="{StaticResource LabelText}" FontSize="20" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="ON DISK" Style="{StaticResource LabelText}" Opacity="0.7" />
                    <TextBlock Name="SizeText" Style="{StaticResource LabelText}" FontSize="20" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="RECORDED SPAN" Style="{StaticResource LabelText}" Opacity="0.7" />
                    <TextBlock Name="SpanText" Style="{StaticResource LabelText}" FontSize="20" />
                </StackPanel>
                <Button Grid.Column="3" Content="Refresh" Style="{StaticResource Btn}" Padding="10,4" VerticalAlignment="Bottom" Click="Refresh_Click" />
            </Grid>
        </Border>

        <!-- Application list (13.14.j) and Traffic History Chart (13.08) -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="APPLICATIONS" Style="{StaticResource LabelText}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox Name="AppSearch" Style="{StaticResource InputBox}" Width="240" DockPanel.Dock="Right" TextChanged="AppSearch_TextChanged" ToolTip="filter by name" />
            </DockPanel>
            <DataGrid Name="StatsGrid" Grid.Row="1" RowHeight="30" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource Line}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                      SelectionMode="Extended" Sorting="StatsGrid_Sorting">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="application" Width="2*" ElementStyle="{StaticResource CellText}" Binding="{Binding App}" />
                    <DataGridTextColumn Header="download" Width="130" ElementStyle="{StaticResource CellText}" Binding="{Binding DownloadText}" />
                    <DataGridTextColumn Header="upload" Width="130" ElementStyle="{StaticResource CellText}" Binding="{Binding UploadText}" />
                    <DataGridTextColumn Header="total" Width="130" ElementStyle="{StaticResource CellText}" Binding="{Binding TotalText}" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Dual-direction history traffic canvas chart (13.08) -->
            <Border Grid.Row="2" Height="90" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0">
                <Grid>
                    <Canvas Name="HistoryChartCanvas" ClipToBounds="True" />
                    <TextBlock Text="Traffic Volume Distribution (In / Out)" Style="{StaticResource LabelText}" Opacity="0.5" Margin="8,4,0,0" VerticalAlignment="Top" />
                </Grid>
            </Border>
        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="delete days" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Name="FromBox" Style="{StaticResource InputBox}" Width="92" Text="2026-01-01" ToolTip="start yyyy-MM-dd" />
                <TextBlock Text="→" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="6,0" />
                <TextBox Name="ToBox" Style="{StaticResource InputBox}" Width="92" Text="2026-01-31" ToolTip="end yyyy-MM-dd" />
                <Button Content="Delete range" Style="{StaticResource Btn}" Padding="9,3" Margin="8,0,0,0" Click="DeleteRange_Click" />
                <Button Content="Delete selected app" Style="{StaticResource Btn}" Padding="9,3" Margin="8,0,0,0" Click="DeleteApp_Click" />
                <Button Content="Check integrity" Style="{StaticResource Btn}" Padding="9,3" Margin="8,0,0,0" Click="Repair_Click" />
                <Button Content="Compact DB" Style="{StaticResource Btn}" Padding="9,3" Margin="8,0,0,0" Click="Compact_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="merge into" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Name="MergeTarget" Style="{StaticResource InputBox}" Width="130" ToolTip="target app name" />
                <TextBlock Text="selected apps" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="12,0,8,0" />
                <Button Content="Merge" Style="{StaticResource Btn}" Padding="9,3" Margin="0,0,0,0" Click="Merge_Click" />
                <TextBlock Text="import from" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="16,0,8,0" />
                <Button Content="Browse…" Style="{StaticResource Btn}" Padding="9,3" Margin="0,0,0,0" Click="Import_Click" />
                <TextBlock Name="StatusText" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.8" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
