              <DataGridTextColumn Header="up" Width="95" ElementStyle="{StaticResource CellText}" Binding="{Binding OutRateText}" />
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="Quotas">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,6,0,8">
              <TextBlock Style="{StaticResource LabelText}" VerticalAlignment="Center" Text="a byte budget per app — when today's traffic passes it, the app is blocked automatically" />
              <Button Content="Quota status" Style="{StaticResource Btn}" Padding="9,3" Margin="14,0,0,0" VerticalAlignment="Center" Click="QuotaStatus_Click" />
            </StackPanel>
            <DataGrid Name="QuotaGrid" RowHeight="25" Grid.Row="1" GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource Line}" VerticalGridLinesBrush="{DynamicResource Line}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridTextColumn Header="application" Width="2*" ElementStyle="{StaticResource CellText}" Binding="{Binding App}" />
                <DataGridTextColumn Header="today" Width="110" ElementStyle="{StaticResource CellText}" Binding="{Binding UsedText}" />
                <DataGridTemplateColumn Header="budget (MB)" Width="140">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBox Style="{StaticResource InputBox}" Width="66" Text="{Binding QuotaMbEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="set" Style="{StaticResource Btn}" Padding="7,2" Margin="5,0,0,0" Click="QuotaSet_Click" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="consumed" Width="150">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <ProgressBar Height="4" Minimum="0" Maximum="1" Foreground="{DynamicResource Accent}" Background="{DynamicResource PanelAlt}" BorderThickness="0" Margin="10,0" VerticalAlignment="Center" Value="{Binding QuotaFraction, Mode=OneWay}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="budget / used" Width="190" ElementStyle="{StaticResource CellText}" Binding="{Binding QuotaText}" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>
        <TabItem Header="Schedules">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,6,0,8">
              <StackPanel Orientation="Horizontal">
                <StackPanel>
                  <TextBlock Text="APP" Style="{StaticResource LabelText}" Margin="0,0,0,3" />
                  <TextBox Name="SchApp" Style="{StaticResource InputBox}" Width="140" Text="steam.exe" />
                </StackPanel>
                <StackPanel Margin="12,0,0,0">
                  <TextBlock Text="FROM" Style="{StaticResource LabelText}" Margin="0,0,0,3" />
                  <TextBox Name="SchStart" Style="{StaticResource InputBox}" Width="62" Text="09:00" />
                </StackPanel>
                <StackPanel Margin="8,0,0,0">
                  <TextBlock Text="TO" Style="{StaticResource LabelText}" Margin="0,0,0,3" />
                  <TextBox Name="SchEnd" Style="{StaticResource InputBox}" Width="62" Text="17:00" />
                </StackPanel>
                <StackPanel Margin="12,0,0,0">
                  <TextBlock Text="CAP kbit/s" Style="{StaticResource LabelText}" Margin="0,0,0,3" />
                  <TextBox Name="SchRate" Style="{StaticResource InputBox}" Width="78" Text="256" />
                </StackPanel>
                <StackPanel Margin="12,0,0,0">
                  <TextBlock Text="WHEN" Style="{StaticResource LabelText}" Margin="0,0,0,3" />
                  <ComboBox Name="SchDays" Width="112" SelectedIndex="0" Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Line}">
                    <ComboBoxItem Content="every day" />
                    <ComboBoxItem Content="weekdays" />
                    <ComboBoxItem Content="weekends" />
                  </ComboBox>
                </StackPanel>
                <Button Content="add schedule" Style="{StaticResource BtnAccent}" Padding="12,5" VerticalAlignment="Bottom" Margin="16,0,0,1" Click="ScheduleAdd_Click" />
              </StackPanel>
            </Border>
            <DataGrid Name="ScheduleGrid" RowHeight="25" Grid.Row="1" GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource Line}" VerticalGridLinesBrush="{DynamicResource Line}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridTextColumn Header="application" Width="2*" ElementStyle="{StaticResource CellText}" Binding="{Binding App}" />
                <DataGridTextColumn Header="window" Width="120" ElementStyle="{StaticResource CellText}" Binding="{Binding Window}" />
                <DataGridTextColumn Header="days" Width="140" ElementStyle="{StaticResource CellText}" Binding="{Binding DaysText}" />
                <DataGridTextColumn Header="cap" Width="110" ElementStyle="{StaticResource CellText}" Binding="{Binding LimitText}" />
                <DataGridTextColumn Header="active now" Width="100" ElementStyle="{StaticResource CellText}" Binding="{Binding IsActiveNow}" />
                <DataGridTemplateColumn Header="" Width="86">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="remove" Style="{StaticResource Btn}" Padding="7,2" Click="ScheduleDelete_Click" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>
        <TabItem Header="Rule List">
          <Grid Margin="0,6,0,0">
