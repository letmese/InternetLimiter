<Window x:Class="Valve.RemoteConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Connect" Height="430" Width="520" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="Remote administration" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Text}" />
    <TextBlock Grid.Row="1" Text="Connect to another machine running Internet Limiter and control it (limits, blocker, snapshots)." Foreground="{DynamicResource TextDim}" Margin="0,4,0,10" TextWrapping="Wrap" />

    <StackPanel Grid.Row="2" Orientation="Horizontal">
      <TextBlock Text="Host:" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Width="90" />
      <TextBox x:Name="HostBox" Width="250" Text="127.0.0.1" Foreground="{DynamicResource Text}" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" />
    </StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
      <TextBlock Text="Port:" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Width="90" />
      <TextBox x:Name="PortBox" Width="120" Text="4045" Foreground="{DynamicResource Text}" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" />
      <TextBlock Text="User (blank = current credentials):" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="12,0,0,0" />
      <TextBox x:Name="UserBox" Width="130" Foreground="{DynamicResource Text}" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" />
    </StackPanel>
    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
      <TextBlock Text="Token:" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Width="90" />
      <TextBox x:Name="TokenBox" Width="250" Foreground="{DynamicResource Text}" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" />
    </StackPanel>
    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
      <Button Content="Connect &amp; Snapshot" Style="{StaticResource Btn}" Padding="10,4" Click="Connect_Click" />
      <Button Content="Save Host" Style="{StaticResource Btn}" Padding="10,4" Margin="8,0,0,0" Click="SaveHost_Click" />
      <CheckBox x:Name="StartServerBox" Content="Listen for remote connections" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="14,0,0,0" Checked="ServerToggle_Changed" Unchecked="ServerToggle_Changed" />
    </StackPanel>

    <GroupBox Grid.Row="6" Header="Host list" Foreground="{DynamicResource TextDim}" Margin="0,12,0,8">
      <ListBox x:Name="HostList" Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Line}" SelectionChanged="HostList_SelectionChanged" />
    </GroupBox>

    <TextBox x:Name="ResultBox" Grid.Row="7" IsReadOnly="True" Height="70" TextWrapping="Wrap"
             Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Line}" FontFamily="Consolas" FontSize="11" />
  </Grid>
</Window>
